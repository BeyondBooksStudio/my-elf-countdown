# 2. Your Supabase "publishable" key. Public by design, safe to share.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_eBn0tU0a1cTxsQ9rJrInmQ_lFX-O28E

# 3. SECRET. Supabase > Connect > "Transaction pooler" connection string,
